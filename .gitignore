# Godot — cache importu, generowany przez `godot --headless --path prototype --import`
.godot/
*.tmp

# Python
__pycache__/
*.pyc

# Eksporty (godot --export-release, patrz prototype/README.md)
build/
# skrót commita dla builda (tools/export_build.sh) — pakowany do eksportu, nie do repo
prototype/build_stamp.txt

# źródła materiałów świata 3D: skany CC0 pobierane z ambientCG (tools/world_pbr_import.py) i wyniki generatorów — wynik trafia do prototype/art/world3d
art_src/world_pbr/
art_src/world_pbr_cc0/
art_src/world_decals/

# nagrania z bibliotek dźwięku (tools/audio_lib_fetch.py): licencja zabrania udostępniania plików dalej — w repo jest tylko rejestr z sumami (prototype/tools/audio_sources.json)
art_src/audio_lib/
# assety zmiksowane z tych nagrań (bake_common.hybrid): tylko lokalnie i w buildach, gra woli je od prototype/audio/
prototype/audio_licensed/

# nagrania trailera (trailer/capture.sh, encode.sh): wyniki tylko lokalnie — gotowy materiał publikować poza repo
trailer/raw/
trailer/out/
# jednorazowe sondy i ich logi w narzędziach
prototype/tools/_probe_*
prototype/tools/_blender_*
# wtyczka edytora Tripo DCC Bridge: instalowana lokalnie, nie jest częścią gry (brak licencji do redystrybucji)
prototype/addons/Tripo3d_Godot_Bridge/
