; Engine configuration file.
config_version=5

[application]

config/name="Dead Air '87 Prototype"
config/version="1.7.218"
config/description="Co-op horror run-and-gun prototype: 8-dir movement, 2-player online, noise-driven stalker."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

InputSetup="*res://scripts/input_setup.gd"
Settings="*res://scripts/settings.gd"
NoiseMgr="*res://scripts/noise_manager.gd"
Audio="*res://scripts/audio_director.gd"
Feel="*res://scripts/feel.gd"
Arsenal="*res://scripts/arsenal.gd"
Scrap="*res://scripts/scrap.gd"
Profile="*res://scripts/profile.gd"
Difficulty="*res://scripts/difficulty.gd"
Voice="*res://scripts/voice.gd"
LagComp="*res://scripts/lag_comp.gd"
Director="*res://scripts/director.gd"

[audio]

driver/mix_rate=48000
driver/enable_input=true

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/atlas_size=4096
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
environment/volumetric_fog/volume_size=96
environment/volumetric_fog/volume_depth=96
environment/ssao/quality=2
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.045, 0.07, 1)

[internationalization]

locale/translations=PackedStringArray("res://translations/ui.pl.translation")
locale/fallback="en"
